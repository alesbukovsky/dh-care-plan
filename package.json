{
	"name": "@dh-care-plan/workspace",
	"private": true,
	"scripts": {
		"build:core": "pnpm --filter @dh-care-plan/core run build",
		"build:cli": "pnpm --filter \"@dh-care-plan/cli...\" run build",
		"build:pwa": "pnpm --filter \"@dh-care-plan/pwa...\" run build",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write --error-on-warnings .",
		"typecheck": "pnpm -r --stream --workspace-concurrency=1 run typecheck",
		"test": "pnpm -r --stream --workspace-concurrency=1 run test",
		"dev": "pnpm --filter @dh-care-plan/pwa run dev",
		"serve": "pnpm --filter @dh-care-plan/pwa run serve",
		"link:cli": "pnpm run build:cli && ln -sf \"$PWD/packages/cli/dist/dhplan.js\" \"$PNPM_HOME/bin/dhplan\" && echo \"Linked dhplan -> $PNPM_HOME/bin/dhplan\"",
		"flare": "pnpm run test && pnpm run build:pwa && pnpm --filter @dh-care-plan/pwa run flare",
		"flare:stage": "pnpm run test && pnpm run build:pwa && pnpm --filter @dh-care-plan/pwa run flare:stage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.0.0",
			"onFail": "warn"
		}
	}
}
