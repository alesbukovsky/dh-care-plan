{
	"name": "@dh-care-plan/core",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup",
		"test": "tsc --noEmit && vitest run --coverage"
	},
	"dependencies": {
		"angular-expressions": "1.5.5",
		"docxtemplater": "3.69.2",
		"lodash": "4.17.23",
		"pizzip": "3.2.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "26.1.2",
		"@vitest/coverage-v8": "4.1.10",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}
