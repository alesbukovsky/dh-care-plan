{
	"name": "@dh-care-plan/core",
	"version": "0.5.3",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run typecheck && vitest run --coverage"
	},
	"dependencies": {
		"angular-expressions": "1.6.0",
		"docxtemplater": "3.70.0",
		"lodash": "4.18.1",
		"pizzip": "3.2.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "5.0.1",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	}
}
