{
	"name": "@dh-care-plan/pwa",
	"version": "0.5.5",
	"module": "src/main.tsx",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run typecheck && vitest run --coverage",
