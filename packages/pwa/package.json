		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.1",
		"jsdom": "30.0.1",
		"tailwindcss": "4.3.3",
		"vite": "8.3.0",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "5.0.1",
		"wrangler": "4.132.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@dh-care-plan/core": "workspace:0.5.5",
