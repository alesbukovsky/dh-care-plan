{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dhplan",
	"compatibility_date": "2026-07-27",
	// Assets-only Worker: no `main` entrypoint, Cloudflare serves `dist` directly.
	"assets": {
		"directory": "./dist",
		// Client-side routing: unknown paths return index.html instead of a 404.
		"not_found_handling": "single-page-application"
	}
}
